#!/usr/bin/env python3
"""Regenerate web/app/components/icon-paths.ts from the lucide-static package.
Fetches it with npm inside CT 104 (no node on pve), reads icons/<name>.svg, keeps the inner
elements, writes the lucide record. Edit ICONS and re-run; missing names are reported."""
import re, subprocess, sys, tempfile
from pathlib import Path

CT = "104"
SCRATCH = "/tmp/lucide-gen"
OUT = Path(__file__).resolve().parent.parent / "web/app/components/icon-paths.ts"
ICONS = """thumbs-up thumbs-down message-square zap users lock shield clock bookmark scale flame trophy eye-off
file-text image package x check circle-check triangle-alert pencil sparkles circle-help star trash-2 plus minus
info heart wrench bot list-checks panel-left timer alarm-clock rotate-ccw circle-x ban link globe house calendar history
languages brain flask-conical lightbulb mail-open map-pin building-2 hand-coins paperclip folder terminal mic
volume-2 cloud-upload qr-code smartphone key-round fingerprint refresh-cw chevron-down chevron-up chevron-right
chevron-left ellipsis expand maximize-2 external-link target flag gift tag bug rocket bolt eye megaphone share-2
pause square-pen""".split()

def ct(cmd):
    return subprocess.run(["pct", "exec", CT, "--", "sh", "-c", cmd], capture_output=True, text=True)

try:
    r = ct(f"rm -rf {SCRATCH} && mkdir -p {SCRATCH} && cd {SCRATCH} && npm pack lucide-static --silent && tar xzf lucide-static-*.tgz")
    if r.returncode: sys.exit("npm pack failed: " + r.stderr)
    with tempfile.TemporaryDirectory() as tmp:
        subprocess.run(["pct", "exec", CT, "--", "tar", "-C", f"{SCRATCH}/package/icons", "-cf", "-", "."],
                       stdout=open(f"{tmp}/i.tar", "wb"), check=True)
        subprocess.run(["tar", "-C", tmp, "-xf", f"{tmp}/i.tar"], check=True)
        out, missing = {}, []
        for n in sorted(set(ICONS)):
            f = Path(tmp) / f"{n}.svg"
            if not f.exists(): missing.append(n); continue
            m = re.search(r"<svg[^>]*>(.*)</svg>", f.read_text(), re.S)
            out[n] = re.sub(r">\s+<", "><", m.group(1).strip()).replace("\n", "")
finally:
    ct(f"rm -rf {SCRATCH}")

lines = ["// generated by scripts/gen-icons from lucide-static; do not edit", "export const lucide: Record<string, string> = {"]
lines += [f"  '{k}': '{v}'," for k, v in out.items()] + ["}", ""]
OUT.write_text("\n".join(lines))
print(f"wrote {len(out)} icons to {OUT}; missing: {missing or 'none'}")
