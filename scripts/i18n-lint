#!/usr/bin/env python3
"""i18n-lint — flags new hardcoded UI strings in .vue templates (core web/app and each add-on's web/app).

Strings move to $t() gradually, so this compares against a baseline (web/i18n/raw-strings.json: file → count):
a file with more raw strings than its baseline, or a new file with any, fails. --update rewrites the baseline
(run it after moving strings over, so the count can only go down). --list prints every raw string found.
Raw = template text with letters outside {{ }}, and placeholder/title/aria-label/label attributes that aren't bound.
"""
import json, re, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BASE = ROOT / "web/i18n/raw-strings.json"
TEXT = re.compile(r">([^<>]*)<")
ATTR = re.compile(r'(?<![:@\w-])(placeholder|title|aria-label|label)="([^"]*[A-Za-z]{2,}[^"]*)"')
MUSTACHE = re.compile(r"\{\{.*?\}\}", re.S)


def template(src):
    m = re.search(r"<template>(.*)</template>", src, re.S)
    return re.sub(r"<!--.*?-->", "", m.group(1), flags=re.S) if m else ""


def raw(f: Path):
    t = template(f.read_text())
    out = []
    for m in TEXT.finditer(t):
        s = MUSTACHE.sub("", m.group(1)).strip()
        if re.search(r"[A-Za-z]{2,}", s):
            out.append(" ".join(s.split())[:80])
    out += [f'{a}="{v}"' for a, v in ATTR.findall(t)]
    return out


def files():
    for d in [ROOT / "web/app", *sorted((ROOT / "addons").glob("*/web/app"))]:
        yield from sorted(d.rglob("*.vue"))


def main():
    found = {str(f.relative_to(ROOT)): raw(f) for f in files()}
    counts = {k: len(v) for k, v in found.items() if v}
    if "--list" in sys.argv:
        for k, v in found.items():
            for s in v:
                print(f"{k}: {s}")
    if "--update" in sys.argv:
        BASE.write_text(json.dumps(dict(sorted(counts.items())), indent=1) + "\n")
        return print(f"baseline: {sum(counts.values())} raw strings in {len(counts)} files")
    base = json.loads(BASE.read_text()) if BASE.exists() else {}
    worse = [(k, n, base.get(k, 0)) for k, n in counts.items() if n > base.get(k, 0)]
    for k, n, b in worse:
        new = found[k][:]
        print(f"{k}: {n} raw strings (baseline {b}) — move new text to $t(); e.g. {new[-1]!r}")
    better = sum(b - counts.get(k, 0) for k, b in base.items() if counts.get(k, 0) < b)
    if better:
        print(f"{better} fewer raw strings than the baseline: run scripts/i18n-lint --update")
    sys.exit(1 if worse else 0)


if __name__ == "__main__":
    main()
