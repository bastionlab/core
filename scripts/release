#!/usr/bin/env bash
# release <x.y.z | x.y.z-beta.N> — bump VERSION, prepend the CHANGELOG.md section, commit and tag v<version>.
# Nothing is pushed: `git push origin main v<version>` then lets .github/workflows/release.yml build the release
# (a version with "-" in it is a pre-release: only boxes on the beta channel see it).
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
V=${1:?usage: scripts/release <x.y.z>}
[[ "$V" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || { echo "not a version: $V" >&2; exit 1; }
git diff --quiet && git diff --cached --quiet || { echo "commit your changes first" >&2; exit 1; }
git rev-parse -q --verify "refs/tags/v$V" >/dev/null && { echo "v$V exists already" >&2; exit 1; }
echo "$V" > VERSION
python3 scripts/changelog "$V" --write >/dev/null
git add VERSION CHANGELOG.md
git commit -q -m "release: v$V"
git tag -a "v$V" -m "v$V"
echo "tagged v$V — push with: git push origin HEAD v$V"
