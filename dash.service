[Unit]
Description=Bastion (Nuxt)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/dash.env
WorkingDirectory=/opt/dash
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=3
# a fixed user (not DynamicUser) so dash and dash-b read and write the same /var/lib/dash files
User=dash
Group=dash
# notes.db + pasted images (/var/lib/dash) — inside the CT, so the nightly vzdump keeps them
StateDirectory=dash

[Install]
WantedBy=multi-user.target
