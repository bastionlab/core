def write_compose(s):
    tpl = TEMPLATES[s["template"]]
    env, vols, _ = env_for(s)
    mem = s["settings"].get("memory", tpl["ram"])
    limit = mem + 3 if s["template"] == "atm10sky" else mem  # MC: MEMORY is the heap, the JVM needs room on top
    q = lambda v: json.dumps(str(v))  # JSON strings are valid YAML scalars
    L = ["services:", "  server:", f"    image: {tpl['image']}", f"    container_name: {cname(s['id'])}",
         "    restart: unless-stopped", f"    mem_limit: {limit}g", "    stop_grace_period: 2m", "    tty: true",
         "    stdin_open: true", "    labels:", f"      gsm.id: {q(s['id'])}", "    ports:"]
    for p in s["ports"]:
        bind = "127.0.0.1:" if p.get("local") else ""
        spec = "%s%d:%d/%s" % (bind, p["port"], p.get("inner", p["port"]), p["proto"])
        L.append(f"      - {q(spec)}")
    L.append("    environment:")
    L += [f"      {k}: {q(v)}" for k, v in env.items()]
    L.append("    volumes:")
    L += [f"      - {q(f'{a}:{b}')}" for a, b in vols.items()]
    (ROOT / s["id"] / "compose.yml").write_text("\n".join(L) + "\n")


def compose(sid, *args, timeout=900):
    return run("docker", "compose", "-p", cname(sid), "-f", str(ROOT / sid / "compose.yml"), *args, timeout=timeout)


# --- ATM10 Sky pack ---------------------------------------------------------
def pack_versions():
    """newest ATM10 Sky releases with a server pack, cached 6 h (CurseForge's website API needs no key)"""
    cf = CACHE / "atm10sky-versions.json"
    if cf.exists() and time.time() - cf.stat().st_mtime < 6 * 3600:
        return json.loads(cf.read_text())
    try:
        data = http_json(f"https://www.curseforge.com/api/v1/mods/{ATM10SKY_PROJECT}/files?pageIndex=0&pageSize=15"
                         "&sort=dateCreated&sortDescending=true&removeAlphas=true")["data"]
        vers = []
        for f in data:
            if not (f.get("additionalServerPackFilesCount") or f.get("additionalFilesCount")):
                continue
            m = re.search(r"(\d+\.\d+\.\d+)", f["fileName"])
            if m:
                vers.append({"version": m[1], "fileId": f["id"], "date": f["dateCreated"]})
        if vers:
            CACHE.mkdir(parents=True, exist_ok=True)
            cf.write_text(json.dumps(vers))
        return vers
    except Exception:
        return json.loads(cf.read_text()) if cf.exists() else []


def fetch_pack(version, op):
    vers = pack_versions()
    v = next((x for x in vers if x["version"] == version), None) if version != "latest" else (vers[0] if vers else None)
    if not v:
        raise RuntimeError("ATM10 Sky version not found on CurseForge")
    extra = http_json(f"https://www.curseforge.com/api/v1/mods/{ATM10SKY_PROJECT}/files/{v['fileId']}/additional-files")
    sp = next(f for f in extra["data"] if "server" in f["fileName"].lower())
    fid = str(sp["id"])
    url = f"https://mediafilez.forgecdn.net/files/{int(fid[:4])}/{int(fid[4:])}/{sp['fileName']}"
    dest = CACHE / sp["fileName"]
    if not dest.exists() or dest.stat().st_size != sp["fileLength"]:
        op(f"downloading {sp['fileName']} ({sp['fileLength'] // 2**20} MB)")
        tmp = dest.with_suffix(".part")
        with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60) as r, open(tmp, "wb") as fh:
            shutil.copyfileobj(r, fh, 1 << 20)
        tmp.replace(dest)
    import zipfile
    with zipfile.ZipFile(dest) as z:
        sh_ = next((n for n in z.namelist() if n.endswith("startserver.sh")), None)
        txt = z.read(sh_).decode() if sh_ else ""
    m = re.search(r"NEOFORGE_VERSION=([\d.]+)", txt)
    if not m:
        raise RuntimeError("could not read the NeoForge version from the server pack")
    return {"version": v["version"], "file": sp["fileName"], "neoforge": m[1], "mc": "1.21.1"}


# --- status -----------------------------------------------------------------
def docker_state():
    """containers + memory/CPU straight from their cgroups (docker stats --no-stream samples for ~2 s)"""
    ps = {}
    for line in run("docker", "ps", "-a", "--no-trunc", "--filter", "label=gsm.id", "--format", "{{json .}}").stdout.splitlines():
        d = json.loads(line)
        ps[d["Names"]] = d
    stats, prev_f = {}, Path("/run/gsm-cpu.json")
    prev = json.loads(prev_f.read_text()) if prev_f.exists() else {}
    now, cur = time.time(), {}
    for name, d in ps.items():
        cg = Path(f"/sys/fs/cgroup/system.slice/docker-{d['ID']}.scope")
        if d["State"] != "running" or not cg.exists():
            continue
        try:
            mem = int((cg / "memory.current").read_text())
            limit = (cg / "memory.max").read_text().strip()
            fstat = dict(l.split() for l in (cg / "memory.stat").read_text().splitlines())
            mem -= int(fstat.get("inactive_file", 0))  # what docker stats shows: page cache that can go is not "used"
            usec = int(dict(l.split() for l in (cg / "cpu.stat").read_text().splitlines())["usage_usec"])
        except Exception:
            continue
        cur[name] = [now, usec]
        cpu = 0.0
        if name in prev and now > prev[name][0]:
            cpu = (usec - prev[name][1]) / 1e6 / (now - prev[name][0]) * 100
        stats[name] = {"mem": max(mem, 0), "limit": int(limit) if limit.isdigit() else 0, "cpu": max(cpu, 0.0)}
    prev_f.write_text(json.dumps(cur))
    return ps, stats


def mc_players(sid):
    r = run("docker", "exec", cname(sid), "rcon-cli", "list", timeout=8)
    m = re.search(r"There are (\d+) of a max of (\d+) players online:?\s*(.*)", re.sub(r"§.|\x1b\[[0-9;]*m", "", r.stdout))
    if not m:
        return None
    return {"online": int(m[1]), "max": int(m[2]), "names": [x.strip() for x in m[3].split(",") if x.strip()]}


def op_state(sid):
    p = ROOT / sid / "op.json"
    if not p.exists():
        return None
    o = json.loads(p.read_text())
    if not o.get("done") and o.get("pid") and not Path(f"/proc/{o['pid']}").exists():
        o.update(done=True, error=o.get("error") or "interrupted")
    if o.get("done") and time.time() - o.get("end", 0) > 600 and not o.get("error"):
        return None
    return o


def server_view(s, ps, stats):
    sid, tpl = s["id"], TEMPLATES[s["template"]]
    c = ps.get(cname(sid))
    st = stats.get(cname(sid), {})
    status = "missing"
    health = None
    if c:
        status = c["State"]
        m = re.search(r"\((healthy|unhealthy|health: starting)\)", c.get("Status", ""))
        health = m[1].replace("health: ", "") if m else None
    v = {"id": sid, "template": s["template"], "game": tpl["game"], "icon": tpl["icon"], "kind": tpl["name"],
         "name": s.get("name") or tpl["name"], "status": status, "health": health, "uptime": c.get("Status") if c else "",
         "created": s.get("created"), "ports": s["ports"], "address": s.get("address", ""),
         "settings": {k: ("•" * 8 if f["type"] == "password" and s["settings"].get(k) else s["settings"].get(k))
                      for f in tpl["fields"] for k in [f["key"]]},
         "secrets": {f["key"]: s["settings"].get(f["key"]) for f in tpl["fields"] if f["type"] == "password"},
         "mem": st.get("mem", 0), "memLimit": st.get("limit", 0), "cpu": round(st.get("cpu", 0.0), 1), "op": op_state(sid),
         "console": tpl["game"] in ("minecraft", "ark"), "pack": s.get("pack")}
    if tpl["game"] == "minecraft" and status == "running" and health == "healthy":
        v["players"] = mc_players(sid)
    bk = sorted((BACKUPS / sid).glob("*.tar.zst"), reverse=True) if (BACKUPS / sid).exists() else []
    v["backups"] = [{"file": b.name, "size": b.stat().st_size, "time": int(b.stat().st_mtime)} for b in bk]
    return v


def playit_view():
    r = run("playit", "status", timeout=10)
    txt = r.stdout + r.stderr
    phase = (re.search(r"Phase:\s*(.+)", txt) or [None, "unknown"])[1].strip()
    ok = "Secret configured: true" in txt
    claim = None
    cp = ROOT / "_playit-claim.json"
    if not ok and cp.exists():
        c = json.loads(cp.read_text())
        if time.time() - c["time"] < 1800 and Path(f"/proc/{c['pid']}").exists():
            claim = c["url"]
    return {"installed": r.returncode == 0 or "playit" in txt, "phase": phase, "claimed": ok, "claimUrl": claim,
            "running": run("systemctl", "is-active", "playit").stdout.strip() == "active"}


def mem_host():
    m = {l.split(":")[0]: int(l.split()[1]) * 1024 for l in open("/proc/meminfo")}
    return {"total": m["MemTotal"], "avail": m["MemAvailable"]}


def cmd_list():
    ps, stats = docker_state()
    servers = []
    for p in sorted(ROOT.glob("*/server.json")):
        try:
            servers.append(server_view(json.loads(p.read_text()), ps, stats))
        except Exception as e:
            servers.append({"id": p.parent.name, "error": str(e)[:200]})
    servers.sort(key=lambda s: s.get("created") or 0)
    tpls = [{"id": k, **{x: t[x] for x in ("name", "game", "icon", "desc", "ram", "fields", "ports")}}
            for k, t in TEMPLATES.items()]
    pv = pack_versions()
    st = os.statvfs(ROOT)
    out({"servers": servers, "templates": tpls, "playit": playit_view(), "mem": mem_host(),
         "disk": {"free": st.f_bavail * st.f_frsize, "total": st.f_blocks * st.f_frsize},
         "atm10sky": {"latest": pv[0]["version"] if pv else None, "versions": [x["version"] for x in pv]}})


# --- background ops ---------------------------------------------------------
def background(sid, op, *argv):
    o = op_state(sid)
    if o and not o.get("done"):
        die(f"busy: {o['op']}")
    log = open(ROOT / sid / "op.log", "w")
    p = subprocess.Popen([sys.argv[0], "_run", sid, op, *argv], stdout=log, stderr=subprocess.STDOUT,
                         start_new_session=True)
    (ROOT / sid / "op.json").write_text(json.dumps({"op": op, "pid": p.pid, "start": time.time(), "msg": "starting"}))
    out({"ok": True, "op": op})


def _run(sid, op, *argv):
    p = ROOT / sid / "op.json"
    state = json.loads(p.read_text())

    def say(msg):
        state["msg"] = msg
        p.write_text(json.dumps(state))
        print(msg, flush=True)

    try:
        s = load(sid)
        if op == "create" or op == "update":
            if s["template"] == "atm10sky":
                ver = argv[0] if argv else "latest"
                new = fetch_pack(ver, say)
                if op == "update" and s.get("pack", {}).get("file") != new["file"]:
                    say("moving the old mods aside")
                    for d in ("mods", "kubejs", "defaultconfigs"):
                        src = ROOT / sid / "data" / d
                        if src.exists():
                            TRASH.mkdir(exist_ok=True)
                            shutil.move(src, TRASH / f"{sid}-{d}-{int(time.time())}")
                    # itzg only re-checks the packs named in this file — the old zip still matches, so drop it
                    (ROOT / sid / "data" / ".generic_pack.sum").unlink(missing_ok=True)
                s["pack"] = new
                save(s)
            if op == "update" and s["template"] != "atm10sky":
                say("restarting (updates via SteamCMD on start)")
                write_compose(s)
                compose(sid, "pull", timeout=1800)
                compose(sid, "up", "-d", "--force-recreate")
            else:
                write_compose(s)
                say(f"pulling {TEMPLATES[s['template']]['image']}")
                compose(sid, "pull", timeout=1800)
                say("starting the container")
                r = compose(sid, "up", "-d", "--force-recreate")
                if r.returncode:
                    raise RuntimeError(r.stderr.strip()[-300:])
            say("started — first boot can take a while (see console)")
        elif op == "apply":
            write_compose(s)
            say("recreating with the new settings")
            r = compose(sid, "up", "-d", "--force-recreate")
            if r.returncode:
                raise RuntimeError(r.stderr.strip()[-300:])
            say("applied")
        elif op == "backup":
            say("saving the world")
            do_backup(s, say)
            say("backup done")
        elif op == "restore":
            do_restore(s, argv[0], say)
            say("restored")
        state.update(done=True, end=time.time())
    except Exception as e:
        state.update(done=True, end=time.time(), error=str(e)[:300])
        print("ERROR", e, flush=True)
    p.write_text(json.dumps(state))


def world_paths(s):
    """what a backup holds, relative to data/"""
    return {"atm10sky": ["world", "server.properties", "whitelist.json", "ops.json", "banned-players.json",
                         "config", "serverconfig"],
            "arkse": ["server/ShooterGame/Saved"],
            "satisfactory": ["saved"]}[s["template"]]


def do_backup(s, say):
    sid = s["id"]
    data = ROOT / sid / "data"
    running = docker_state()[0].get(cname(sid), {}).get("State") == "running"
    if running and s["template"] == "atm10sky":
        run("docker", "exec", cname(sid), "rcon-cli", "save-off", timeout=20)
        run("docker", "exec", cname(sid), "rcon-cli", "save-all flush", timeout=120)
    if running and s["template"] == "arkse":
        run("docker", "exec", "-u", "steam", cname(sid), "arkmanager", "saveworld", timeout=120)
    try:
        paths = [p for p in world_paths(s) if (data / p).exists()]
        if not paths:
            raise RuntimeError("nothing to back up yet (no world saved)")
        (BACKUPS / sid).mkdir(parents=True, exist_ok=True)
        dest = BACKUPS / sid / f"{time.strftime('%Y%m%d-%H%M%S')}.tar.zst"
        say("packing " + ", ".join(paths))
        r = run("tar", "--zstd", "-cf", str(dest), "-C", str(data), *paths, timeout=3600)
        if r.returncode not in (0, 1):  # 1 = a file changed while reading, fine for a live world
            dest.unlink(missing_ok=True)
            raise RuntimeError(r.stderr.strip()[-300:])
    finally:
        if running and s["template"] == "atm10sky":
            run("docker", "exec", cname(sid), "rcon-cli", "save-on", timeout=20)
    for old in sorted((BACKUPS / sid).glob("*.tar.zst"), reverse=True)[KEEP_BACKUPS:]:
        old.unlink()


def do_restore(s, name, say):
    sid = s["id"]
    src = BACKUPS / sid / name
    if not re.fullmatch(r"\d{8}-\d{6}\.tar\.zst", name) or not src.exists():
        raise RuntimeError("no such backup")
    say("stopping the server")
    compose(sid, "stop", timeout=300)
    data = ROOT / sid / "data"
    TRASH.mkdir(exist_ok=True)
    keep = TRASH / f"{sid}-before-restore-{int(time.time())}"
    keep.mkdir()
    for p in world_paths(s):
        if (data / p).exists():
            (keep / p).parent.mkdir(parents=True, exist_ok=True)
            shutil.move(data / p, keep / p)
    say(f"unpacking {name} (current world kept in _trash)")
    run("tar", "--zstd", "-xf", str(src), "-C", str(data), timeout=3600, check=True)
    say("starting")
    compose(sid, "start")


# --- commands ---------------------------------------------------------------
def cmd_create(template, sid, name, settings_json):
    if template not in TEMPLATES:
        die("unknown template")
    d = sdir(sid)
    if d.exists():
        die("a server with that id exists")
    tpl = TEMPLATES[template]
    settings = clean_settings(tpl, json.loads(settings_json or "{}"))
    name = (name or tpl["name"]).strip()[:40]
    d.mkdir(parents=True)
    (d / "data").mkdir()
    if template in ("arkse", "satisfactory"):
        os.chown(d / "data", 1000, 1000)
    save({"id": sid, "template": template, "name": name, "settings": settings, "ports": pick_ports(tpl),
          "created": int(time.time()), "address": ""})
    background(sid, "create", settings.get("version", "latest") if template == "atm10sky" else "")


def cmd_set(sid, settings_json, apply):
    s = load(sid)
    given = json.loads(settings_json)
    tpl = TEMPLATES[s["template"]]
    for f in tpl["fields"]:  # the UI shows passwords masked; an unchanged mask keeps the stored one
        if f["type"] == "password" and given.get(f["key"]) == "•" * 8:
            given.pop(f["key"])
    if "name" in given:
        s["name"] = str(given.pop("name")).strip()[:40] or tpl["name"]
    if "address" in given:
        a = str(given.pop("address")).strip()
        if a and not re.fullmatch(r"[A-Za-z0-9.-]{1,120}(:\d{1,5})?", a):
            die("address: host or host:port")
        s["address"] = a
    s["settings"] = clean_settings(tpl, given, s["settings"])
    save(s)
    write_compose(s)
    running = docker_state()[0].get(cname(sid), {}).get("State") == "running"
    if apply == "1" and running:
        background(sid, "apply")
    out({"ok": True, "restartNeeded": running and apply != "1"})


def cmd_power(sid, action):
    s = load(sid)
    if action == "start":
        write_compose(s)
        r = compose(sid, "up", "-d")
    elif action == "stop":
        r = compose(sid, "stop", timeout=300)
    elif action == "restart":
        write_compose(s)
        r = compose(sid, "up", "-d", "--force-recreate", timeout=300)
    else:
        die("bad action")
    if r.returncode:
        die(r.stderr.strip()[-300:])
    out({"ok": True})


def cmd_logs(sid, n):
    load(sid)
    n = max(10, min(int(n), 2000))
    r = run("docker", "logs", "--tail", str(n), cname(sid), timeout=20)
    txt = (r.stdout + r.stderr) if r.returncode == 0 else ""
    op = ROOT / sid / "op.log"
    out({"log": txt[-200_000:], "op": op.read_text()[-4000:] if op.exists() else ""})


def cmd_console(sid, command):
    s = load(sid)
    command = command.strip()
    if not command or len(command) > 200 or "\n" in command:
        die("bad command")
    if s["template"] == "atm10sky":
        r = run("docker", "exec", cname(sid), "rcon-cli", command.lstrip("/"), timeout=30)
    elif s["template"] == "arkse":
        r = run("docker", "exec", "-u", "steam", cname(sid), "arkmanager", "rconcmd", command, timeout=30)
    else:
        die("this game has no console")
    out({"out": re.sub(r"§.|\x1b\[[0-9;]*m", "", (r.stdout + r.stderr).strip())[-4000:]})


def cmd_remove(sid):
    load(sid)
    compose(sid, "down", timeout=300)
    TRASH.mkdir(exist_ok=True)
    dest = TRASH / f"{sid}-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.move(ROOT / sid, dest)
    if (BACKUPS / sid).exists():
        shutil.move(BACKUPS / sid, dest / "_backups")
    out({"ok": True, "trash": str(dest)})


def cmd_playit_claim():
    v = playit_view()
    if v["claimed"]:
        out({"ok": True, "claimed": True})
    if v["claimUrl"]:
        out({"url": v["claimUrl"]})
    code = run("playit", "claim", "generate").stdout.strip()
    if not re.fullmatch(r"[0-9a-f]{6,32}", code):
        die("playit claim generate failed")
    url = run("playit", "claim", "url", "--name", "pve-gameservers", code).stdout.strip()
    # exchange blocks until the owner approves on playit.gg, then we hand the secret to playitd
    script = (f"set -e; s=$(playit claim exchange --wait 1800 {code} | grep -oE '[0-9a-f]{{64}}' | tail -1); [ -n \"$s\" ]; "
              "umask 077; printf 'secret_key = \"%s\"\\n' \"$s\" > /etc/playit/playit.toml; "
              "chown playit:playit /etc/playit/playit.toml; systemctl restart playit")
    p = subprocess.Popen(["sh", "-c", script], stdout=subprocess.DEVNULL, stderr=open(ROOT / "_playit-claim.log", "w"),
                         start_new_session=True)
    (ROOT / "_playit-claim.json").write_text(json.dumps({"url": url, "pid": p.pid, "time": time.time()}))
    out({"url": url})


def main():
    a = sys.argv[1:]
    if not a:
        die("usage: gsm list|create|set|start|stop|restart|logs|cmd|backup|restore|update|remove|playit-claim")
    c = a[0]
    ROOT.mkdir(exist_ok=True)
    CACHE.mkdir(exist_ok=True)
    if c == "list":
        cmd_list()
    if c == "create":
        cmd_create(a[1], a[2], a[3], a[4] if len(a) > 4 else "{}")
    if c == "set":
        cmd_set(a[1], a[2], a[3] if len(a) > 3 else "0")
    if c in ("start", "stop", "restart"):
        cmd_power(a[1], c)
    if c == "logs":
        cmd_logs(a[1], a[2] if len(a) > 2 else "300")
    if c == "cmd":
        cmd_console(a[1], a[2])
    if c == "backup":
        load(a[1])
        background(a[1], "backup")
    if c == "restore":
        load(a[1])
        background(a[1], "restore", a[2])
    if c == "update":
        load(a[1])
        background(a[1], "update", a[2] if len(a) > 2 else "latest")
    if c == "remove":
        cmd_remove(a[1])
    if c == "playit-claim":
        cmd_playit_claim()
    if c == "_run":
        _run(*a[1:])
        return
    die("unknown command")


if __name__ == "__main__":
    main()
