def out(obj):
    print(json.dumps(obj))
    sys.exit(0)


def die(msg):
    print(json.dumps({"error": msg}))
    sys.exit(1)


def run(*args, timeout=120, check=False):
    r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    if check and r.returncode:
        raise RuntimeError((r.stderr or r.stdout).strip()[-400:] or f"{args[0]} failed")
    return r


def http_json(url, timeout=20):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=timeout) as r:
        return json.loads(r.read())


def sdir(sid):
    if not ID_RE.fullmatch(sid or ""):
        die("bad server id")
    return ROOT / sid


def load(sid):
    p = sdir(sid) / "server.json"
    if not p.exists():
        die(f"no server {sid}")
    return json.loads(p.read_text())


def save(s):
    p = ROOT / s["id"] / "server.json"
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(s, indent=1))
    os.chmod(tmp, 0o600)
    tmp.replace(p)


def cname(sid):
    return f"gs-{sid}"


# --- settings ---------------------------------------------------------------
def clean_settings(tpl, given, old=None):
    """validate settings against the template's fields; unknown keys are dropped, bad values refused"""
    res = dict(old or {})
    for f in tpl["fields"]:
        k = f["key"]
        if k not in given:
            if k not in res:
                d = f["default"]
                res[k] = secrets.token_urlsafe(12) if d == "@gen" else d
            continue
        v = given[k]
        t = f["type"]
        if t == "bool":
            v = bool(v)
        elif t == "number":
            v = int(float(v))
            if not f.get("min", -1e9) <= v <= f.get("max", 1e9):
                die(f"{f['label']}: {f.get('min')}–{f.get('max')}")
        elif t == "select":
            if v not in f["options"]:
                die(f"{f['label']}: pick one of the options")
        elif t == "list":
            items = [x.strip() for x in str(v).replace("\n", ",").split(",") if x.strip()]
            if any(not re.fullmatch(r"[A-Za-z0-9_.-]{1,40}", x) for x in items):
                die(f"{f['label']}: letters, digits, _ . - only")
            v = ",".join(items)
        else:
            v = str(v)
            if len(v) > 80 or any(c in v for c in "\n\r\"'$`\\"):
                die(f"{f['label']}: max 80 chars, no quotes/backslash/$")
        res[k] = v
    return res


def ports_in_use(skip=None):
    used = set()
    for p in ROOT.glob("*/server.json"):
        s = json.loads(p.read_text())
        if s["id"] != skip:
            used |= {(x["port"], x["proto"]) for x in s.get("ports", [])}
    return used


def pick_ports(tpl):
    used = ports_in_use()
    for off in range(0, 50):
        ports = [dict(p, port=p["port"] + off) for p in tpl["ports"]]
        if not any((p["port"], p["proto"]) in used for p in ports):
            return ports
    die("no free ports")


