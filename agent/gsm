#!/usr/bin/env python3
"""gsm — game server manager inside CT 110 (gameservers). The dashboard agent calls it via `pct exec 110 -- gsm …`.

Every server is a docker compose project in /srv/games/<id>/ (server.json = template + settings, compose.yml is
generated from it, data/ is the container's volume). Slow work (pulling images, downloading packs, backups) runs
detached; its progress lands in <id>/op.json so `gsm list` can show it. Nothing here deletes a world: remove and
restore move the old files to /srv/games/_trash/.
"""
import json, os, re, secrets, shutil, subprocess, sys, time, urllib.request
from pathlib import Path

