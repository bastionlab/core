#!/usr/bin/env python3
"""addon-publish <id> — the Publish button: send addons/<id> to the marketplace and wait until it is live.

  1. bumps the patch version when it isn't higher than the marketplace's (written back into addons/<id>)
  2. runs the same gate GitHub will (.github/check/check.py from the marketplace's main, no lint) for a quick no
  3. pushes the folder to a `publish/<id>` branch of marketplace.repo and opens (or reuses) its pull request
  4. waits for .github/workflows/publish.yml there: malware + secrets + style + lint; all green = it merges and
     rebuilds index.json, and every install sees the new version on /addons (auto-update pulls it within the hour)
The GitHub token (marketplace.token_file) goes to GitHub only, through the environment, never an argv.
On the owner's box (addons/ is a checkout of the marketplace repo) the checkout is fast-forwarded afterwards.
"""
import json, re, shutil, subprocess, sys, tempfile, time, urllib.error, urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import importlib.machinery, importlib.util  # noqa: E402

_l = importlib.machinery.SourceFileLoader("addon_get", str(Path(__file__).resolve().parent / "addon-get"))
ag = importlib.util.module_from_spec(importlib.util.spec_from_loader("addon_get", _l))
_l.exec_module(ag)

REPO = (ag.MK.get("repo") or "https://github.com/bastionlab/addons").rstrip("/")
SLUG = REPO.removeprefix("https://github.com/")
API = f"https://api.github.com/repos/{SLUG}"
WAIT = 30 * 60
IGNORE = shutil.ignore_patterns("__pycache__", "node_modules", ".nuxt", ".output", "*.pyc", ".DS_Store")
say = ag.say


def gh(path, method="GET", body=None, ok404=False):
    url = path if path.startswith("https://") else f"https://api.github.com{path}"
    req = urllib.request.Request(url, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"token {ag.token()}", "Accept": "application/vnd.github+json",
                                          "User-Agent": "bastion"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read() or "null")
    except urllib.error.HTTPError as e:
        if ok404 and e.code == 404:
            return None
        msg = (e.read() or b"").decode(errors="replace")[:300]
        sys.exit(f"GitHub {method} {path}: {e.code} {msg}")


def bump(v):
    a = [int(x) for x in v.split(".")]
    return f"{a[0]}.{a[1]}.{a[2] + 1}"


def set_field(f: Path, key, value):
    t = f.read_text()
    rx = re.compile(rf"^{key}:[^\n#]*?(\s*#.*)?$", re.M)
    t = rx.sub(lambda m: f"{key}: {value}{m.group(1) or ''}", t, count=1) if rx.search(t) else t.rstrip("\n") + f"\n{key}: {value}\n"
    f.write_text(t)


def run(*a, cwd=None):
    r = subprocess.run(a, cwd=cwd, capture_output=True, text=True, timeout=300)
    if r.returncode:
        sys.exit(f"{a[0]} {a[1] if len(a) > 1 else ''} failed: {(r.stderr or r.stdout).strip()[:400]}")
    return r.stdout


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if len(args) != 1 or not ag.ID_RE.match(args[0]):
        sys.exit(__doc__)
    aid = args[0]
    here = ag.ADDONS / aid
    if not (here / "addon.yaml").exists():
        sys.exit(f"addons/{aid} has no addon.yaml")
    if not ag.token():
        sys.exit("no GitHub token: set one on Settings → Connections")
    me = gh("/user")
    login = me["login"]
    m = ag.manifest(here)
    if m.get("id") != aid:
        sys.exit(f"addon.yaml says id {m.get('id')!r}, the folder is {aid!r}")

    there = gh(f"/repos/{SLUG}/contents/{aid}/addon.yaml?ref=main", ok404=True)
    remote = None
    if there:
        import base64
        remote = {k.strip(): v.split("#")[0].strip().strip("'\"") for k, _, v in
                  (ln.partition(":") for ln in base64.b64decode(there["content"]).decode().splitlines()
                   if ":" in ln and not ln.startswith((" ", "#")))}

    with tempfile.TemporaryDirectory() as t:
        t = Path(t)
        # 1. the marketplace's main, with only .github and this add-on checked out
        src = t / "repo"
        say(f"fetching {REPO}")
        ag.git("clone", "-q", "--filter=blob:none", "--sparse", REPO, str(src))
        ag.git("sparse-checkout", "set", ".github", aid, cwd=src)
        base = t / "base"
        shutil.copytree(src, base, ignore=shutil.ignore_patterns(".git"))
        dest = src / aid

        def copy():
            shutil.rmtree(dest, ignore_errors=True)
            shutil.copytree(here, dest, ignore=IGNORE, symlinks=True)
        copy()
        if not run("git", "status", "--porcelain", "--", aid, cwd=src).strip():
            say(f"nothing to publish: {aid} {m.get('version')} is what the marketplace has")
            return
        # 2. version + author, written back into addons/<id> too
        if not remote:
            say(f"{aid} is new to the marketplace")
            if m.get("author") != login:
                set_field(here / "addon.yaml", "author", login)
                say(f"author set to {login} (your GitHub login)")
        elif not ag.newer(m.get("version"), remote.get("version")):
            vs = [m.get("version") or "0.0.0", remote.get("version") or "0.0.0"]
            v = bump(max(vs, key=lambda x: [int(p) if p.isdigit() else 0 for p in x.split(".")]))
            set_field(here / "addon.yaml", "version", v)
            say(f"version {m.get('version')} → {v} (the marketplace has {remote.get('version')})")
        m = ag.manifest(here)
        version = m.get("version")
        copy()
        if not (base / ".github/workflows/publish.yml").exists():
            sys.exit(f"{REPO} has no publish workflow (.github/workflows/publish.yml) on main yet; nothing was sent")
        checker = base / ".github/check/check.py"
        if checker.exists():
            say("pre-check (the same gate GitHub runs, without lint)")
            r = subprocess.run([sys.executable, "-I", str(checker), "--id", aid, "--pr", str(src), "--base", str(base),
                                "--author", login], capture_output=True, text=True, timeout=600)
            if r.returncode:
                say(r.stdout)
                sys.exit("the pre-check failed; nothing was sent")
        # 3. branch + PR
        branch = f"publish/{aid}"
        ag.git("checkout", "-q", "-B", branch, cwd=src)
        ag.git("add", "-A", "--", aid, cwd=src)
        env_author = ["-c", f"user.name={login}", "-c", f"user.email={me['id']}+{login}@users.noreply.github.com"]
        ag.git(*env_author, "commit", "-q", "-m", f"{aid} {version}", cwd=src)
        say(f"pushing {branch}")
        ag.git("push", "-q", "-f", "origin", f"HEAD:refs/heads/{branch}", cwd=src)
        sha = run("git", "rev-parse", "HEAD", cwd=src).strip()

    owner = SLUG.split("/")[0]
    pr = next(iter(gh(f"/repos/{SLUG}/pulls?state=open&head={owner}:{branch}") or []), None)
    if not pr:
        pr = gh(f"/repos/{SLUG}/pulls", "POST", {"title": f"Publish {m.get('name', aid)} {version}", "head": branch, "base": "main",
                                                  "body": f"Published from the dashboard by @{login}. Checks run in `publish.yml`; it merges itself when they pass."})
    n = pr["number"]
    say(f"pull request #{n}: {pr['html_url']}")

    # 4. wait for the workflow
    say("checks running on GitHub (malware, secrets, style, lint) …")
    t0, seen = time.time(), ""
    while time.time() - t0 < WAIT:
        time.sleep(15)
        p = gh(f"/repos/{SLUG}/pulls/{n}")
        if p.get("merged"):
            say(f"✅ {aid} {version} is live in the marketplace (installs pick it up on their next check)")
            break
        if p.get("head", {}).get("sha") != sha:
            sys.exit("the branch moved on (published again from somewhere else?); stopped waiting")
        runs = (gh(f"/repos/{SLUG}/commits/{sha}/check-runs") or {}).get("check_runs", [])
        state = ", ".join(f"{r['name']} {r.get('conclusion') or r['status']}" for r in runs) or "queued"
        if state != seen:
            say(f"  {state}")
            seen = state
        if any(r.get("conclusion") in ("failure", "cancelled", "timed_out", "action_required") for r in runs):
            com = [c for c in gh(f"/repos/{SLUG}/issues/{n}/comments") or [] if any(m in (c.get("body") or "") for m in ("bastion-check", "pvedash-check"))]
            if com:
                say(com[-1]["body"].replace("<!-- bastion-check -->", "").replace("<!-- pvedash-check -->", "").strip())
            sys.exit(f"❌ not published: fix the problems above and press Publish again ({pr['html_url']})")
        if runs and all(r.get("conclusion") == "success" for r in runs):
            continue  # checks passed, the merge step is on its way
    else:
        sys.exit(f"still not merged after {WAIT // 60} minutes; see {pr['html_url']}")

    # the owner's checkout: take the merged state (the folder is identical to what was pushed)
    if ag.checkout_mode():
        say("updating this box's marketplace checkout")
        ag.git("fetch", "-q", "origin", "main", cwd=ag.ADDONS)
        if subprocess.run(["git", "cat-file", "-e", f"FETCH_HEAD:{aid}/addon.yaml"], cwd=ag.ADDONS).returncode == 0:
            # a new add-on's files are still untracked here; move them aside so the fast-forward can lay them down
            moved = None
            if subprocess.run(["git", "ls-files", "--error-unmatch", f"{aid}/addon.yaml"], cwd=ag.ADDONS,
                              capture_output=True).returncode:
                moved = Path(tempfile.mkdtemp()) / aid
                shutil.move(str(here), moved)
            r = subprocess.run(["git", "merge", "--ff-only", "-q", "FETCH_HEAD"], cwd=ag.ADDONS, capture_output=True, text=True)
            if r.returncode:
                ag.git("checkout", "-q", "FETCH_HEAD", "--", aid, cwd=ag.ADDONS)
                r = subprocess.run(["git", "merge", "--ff-only", "-q", "FETCH_HEAD"], cwd=ag.ADDONS, capture_output=True, text=True)
            if r.returncode:
                if moved:
                    shutil.move(str(moved), here)
                say(f"could not fast-forward addons/ ({r.stderr.strip()[:200]}); run git pull there")
            else:
                ag.sparse("add", aid)
                if moved:
                    shutil.rmtree(moved.parent, ignore_errors=True)
    ag.remember(aid)


if __name__ == "__main__":
    main()
