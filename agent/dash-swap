#!/bin/sh
# Runs inside CT 104 (dash-live pipes it into `pct exec 104 -- sh -s`) after a green build in /opt/dash-next.
# Swaps the whole tree in as /opt/dash, then restarts the standby (dash-b, :3001, no background workers) and waits
# for it, then the main one (dash, :3000). Caddy and tailscale serve send traffic to whichever answers, so the
# browser never sees a closed port. A failed start puts the previous tree back and restarts both on it.
wait_up() { for i in $(seq 1 30); do curl -sf -o /dev/null "http://127.0.0.1:$1/api/auth/status" && return 0; sleep 1; done; return 1; }
set -e
cd /opt/dash-next
rm -f node_modules
cp -al /opt/dash/node_modules .                       # hard links: no second copy of node_modules on disk
mkdir -p .output/public/_nuxt
cp -an /opt/dash/.output/public/_nuxt/. .output/public/_nuxt/   # old chunks stay reachable for tabs still on the old build
rm -rf /opt/dash-prev
mv /opt/dash /opt/dash-prev
mv /opt/dash-next /opt/dash
if systemctl restart dash-b && wait_up 3001 && systemctl restart dash && wait_up 3000; then
  rm -rf /opt/dash-failed
  exit 0
fi
echo "restart failed, back on the previous build" >&2
rm -rf /opt/dash-failed
mv /opt/dash /opt/dash-failed
mv /opt/dash-prev /opt/dash
systemctl restart dash-b || true
systemctl restart dash || true
exit 1
