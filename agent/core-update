#!/usr/bin/env python3
"""core-update — the core's releases (Add-ons page → Core): check, update, roll back.

  core-update check            JSON: this version, the channel's newest release + its changelog, whether it applies
  core-update apply <tag>      keep this core in /var/lib/dash-core/old, put the release in place, rebuild
  core-update rollback         put the newest kept copy back, rebuild
  core-update channel <stable|beta>
      --no-rebuild             stage only (tests)

Releases are GitHub releases of /etc/dash/core.json `repo` (default bastionlab/core): tags vX.Y.Z, pre-releases
(vX.Y.Z-beta.N) only on the beta channel. The release's asset bastion-core-<version>.tar.gz (built by
.github/workflows/release.yml) is the core without secrets or add-ons. A box whose core is a git checkout (the
owner's) updates by fast-forwarding to the tag instead, and only when the tree is clean and not ahead of it.
Blocked when an installed add-on's addon.yaml `core:` range does not take the new version. Nothing is deleted:
the replaced core is kept as /var/lib/dash-core/old/<version>-<time>.tar.gz (or its commit, for a checkout).
"""
import json, os, re, shutil, subprocess, sys, tarfile, tempfile, time, urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from config import CFG, DASHBOARD, DEVBOX  # noqa: E402
import addon_scan, semver  # noqa: E402

DIR = Path(DASHBOARD)
SETTINGS = Path("/etc/dash/core.json")
OLD = Path(os.environ.get("DASH_CORE_OLD") or "/var/lib/dash-core/old")
TAG_RE = re.compile(r"^v\d+\.\d+\.\d+(-[0-9A-Za-z.]+)?$")
REPO_RE = re.compile(r"^[\w.-]+/[\w.-]+$")
# never part of a release, never overwritten or rolled back: this install's own files
KEEP = {"addons", ".git", "node_modules", "agent/token", "agent/lan_key", "agent/pin_hash", "agent/__pycache__"}
PATH_ENV = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def say(*a):
    print(*a, flush=True)


def settings():
    try:
        s = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        s = {}
    repo = s.get("repo") if REPO_RE.match(str(s.get("repo", ""))) else "bastionlab/core"
    return {"repo": repo, "channel": "beta" if s.get("channel") == "beta" else "stable"}


def version():
    try:
        return (DIR / "VERSION").read_text().strip()
    except OSError:
        return "0.0.0"


def token():
    f = Path((CFG.get("marketplace") or {}).get("token_file") or DEVBOX / "keys/github_token")
    try:
        return f.read_text().strip() or None
    except OSError:
        return None


def gh(path, raw=False):
    """GitHub API (the core repo may be private: the token goes only to api.github.com, in a header)"""
    h = {"Accept": "application/octet-stream" if raw else "application/vnd.github+json", "User-Agent": "bastion"}
    if t := token():
        h["Authorization"] = f"Bearer {t}"
    with urllib.request.urlopen(urllib.request.Request(f"https://api.github.com{path}", headers=h), timeout=60) as r:
        return r.read() if raw else json.loads(r.read())


def releases():
    s = settings()
    out = []
    for r in gh(f"/repos/{s['repo']}/releases?per_page=30"):
        if r.get("draft") or not TAG_RE.match(r.get("tag_name", "")):
            continue
        if r.get("prerelease") and s["channel"] != "beta":
            continue
        out.append(r)
    return sorted(out, key=lambda r: semver.parse(r["tag_name"]), reverse=True)


def is_git():
    return (DIR / ".git").exists()


def git(*a, check=True):
    r = subprocess.run(["git", *a], cwd=DIR, capture_output=True, text=True, timeout=300)
    if check and r.returncode:
        sys.exit(f"git {a[0]}: {(r.stderr or r.stdout).strip()[:300]}")
    return r.stdout.strip()


def blockers(new):
    """installed add-ons whose `core:` range does not take `new`"""
    out = []
    for f in sorted((DIR / "addons").glob("*/addon.yaml")):
        m = {}
        for line in f.read_text().splitlines():
            k, sep, v = line.partition(":")
            if sep and not line.startswith((" ", "#")):
                m[k.strip()] = v.split("#")[0].strip().strip("'\"")
        want = m.get("core")
        try:
            if want and not semver.satisfies(new, want):
                out.append(f"{m.get('name') or f.parent.name} needs core {want}")
        except ValueError:
            out.append(f"{f.parent.name}: bad core range {want!r}")
    return out


def kept():
    """kept cores, newest first (one already rolled back to is renamed .used)"""
    return sorted((p.name for p in OLD.glob("*") if p.name.endswith((".git", ".tar.gz"))), reverse=True) if OLD.is_dir() else []


def check():
    cur, s = version(), settings()
    out = {"current": cur, "channel": s["channel"], "repo": s["repo"], "git": is_git(), "rollback": kept()[:5], "latest": None,
           "newer": False, "blocked": [], "notes": [], "error": None}
    if is_git():
        dirty = git("status", "--porcelain", "--untracked-files=no", check=False)
        out["dirty"] = bool(dirty)
    try:
        rel = releases()
    except Exception as e:
        out["error"] = f"releases unreachable ({e.__class__.__name__}: {str(e)[:120]})"
        return out
    if rel:
        top = rel[0]
        out["latest"] = {"tag": top["tag_name"], "version": top["tag_name"][1:], "prerelease": top.get("prerelease"),
                         "published": top.get("published_at"), "url": top.get("html_url")}
        out["newer"] = semver.newer(top["tag_name"], cur)
        out["blocked"] = blockers(top["tag_name"][1:]) if out["newer"] else []
        # every release between this one and the newest: its notes are the changelog shown on the card
        out["notes"] = [{"tag": r["tag_name"], "body": (r.get("body") or "")[:6000]} for r in rel
                        if semver.newer(r["tag_name"], cur)][:10]
    return out


def keep_current():
    OLD.mkdir(parents=True, exist_ok=True)
    os.chmod(OLD, 0o700)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    if is_git():
        dest = OLD / f"{version()}-{stamp}.git"
        dest.write_text(git("rev-parse", "HEAD") + "\n")
    else:
        dest = OLD / f"{version()}-{stamp}.tar.gz"
        with tarfile.open(dest, "w:gz") as tf:
            for p in sorted(DIR.iterdir()):
                if p.name not in KEEP:
                    tf.add(p, arcname=p.name, filter=lambda ti: None if ti.name in KEEP or "__pycache__" in ti.name else ti)
    say(f"this core kept as {dest}")
    return dest


def put_tree(src: Path):
    """copy a release tree over the core, leaving this install's own files (KEEP) alone"""
    for p in sorted(src.iterdir()):
        if p.name in KEEP:
            continue
        dest = DIR / p.name
        if p.is_dir():
            if dest.exists():
                shutil.rmtree(dest) if dest.is_dir() else dest.unlink()
            shutil.copytree(p, dest, symlinks=True,
                            ignore=lambda d, names: [n for n in names if (Path(d) / n).relative_to(src).as_posix() in KEEP])
        else:
            shutil.copy2(p, dest)


def rebuild(no):
    if no:
        return say("staged (no rebuild)")
    log = "/var/log/dash-rebuild.log"
    r = subprocess.run(["systemd-run", "--unit", "dash-rebuild", "--collect", "--quiet", "-p", f"StandardOutput=append:{log}",
                        "-p", f"StandardError=append:{log}", "-p", "RuntimeMaxSec=30min", "-E", f"PATH={PATH_ENV}",
                        f"{DASHBOARD}/deploy.sh"], capture_output=True, text=True, timeout=20)
    if r.returncode:
        sys.exit(f"could not start the rebuild (one already running?): {r.stderr.strip()[:300]}")
    say(f"rebuild started (dash-rebuild, log {log}); the dashboard is back in a few minutes")


def apply(tag, no_rebuild=False):
    if not TAG_RE.match(tag):
        sys.exit("bad tag")
    rel = next((r for r in releases() if r["tag_name"] == tag), None)
    if not rel:
        sys.exit(f"{tag} is not a release on the {settings()['channel']} channel")
    if b := blockers(tag[1:]):
        sys.exit("blocked: " + "; ".join(b))
    say(f"{version()} → {tag[1:]}")
    if is_git():
        if git("status", "--porcelain", "--untracked-files=no", check=False):
            sys.exit("the core has local changes (git status): commit or stash them first")
        git("fetch", "-q", "--tags", "origin")
        if subprocess.run(["git", "merge-base", "--is-ancestor", "HEAD", tag], cwd=DIR).returncode:
            sys.exit(f"this checkout has commits {tag} lacks: it updates through git, not here")
        keep_current()
        git("merge", "--ff-only", "-q", tag)
    else:
        asset = next((a for a in rel.get("assets") or [] if a["name"] == f"bastion-core-{tag[1:]}.tar.gz"), None)
        if not asset:
            sys.exit(f"{tag} has no bastion-core-{tag[1:]}.tar.gz asset")
        with tempfile.TemporaryDirectory() as t:
            f = Path(t) / "core.tar.gz"
            f.write_bytes(gh(f"/repos/{settings()['repo']}/releases/assets/{asset['id']}", raw=True))
            src = Path(t) / "src"
            src.mkdir()
            with tarfile.open(f) as tf:
                tf.extractall(src, filter="data")
            if not (src / "VERSION").exists() or (src / "VERSION").read_text().strip() != tag[1:]:
                sys.exit("the release tarball's VERSION does not match its tag")
            rep = addon_scan.scan(src, DIR, "core", [])
            say(addon_scan.summary(rep))
            if not rep["ok"]:
                sys.exit("the safety check blocked the release; nothing changed")
            keep_current()
            put_tree(src)
    say(f"✅ core {version()}")
    rebuild(no_rebuild)


def rollback(no_rebuild=False):
    k = kept()
    if not k:
        sys.exit("no earlier core is kept")
    f = OLD / k[0]
    say(f"{version()} → {k[0]}")
    if f.suffix == ".git":
        if not is_git():
            sys.exit(f"{k[0]} is a git commit but the core is no checkout any more")
        sha = f.read_text().strip()
        cur = git("rev-parse", "HEAD")
        git("reset", "--keep", sha)  # refuses rather than overwrite local edits
        (OLD / f"{k[0]}.undone").write_text(cur + "\n")
    else:
        with tempfile.TemporaryDirectory() as t:
            with tarfile.open(f) as tf:
                tf.extractall(t, filter="data")
            put_tree(Path(t))
    f.rename(f.with_name(f.name + ".used"))
    say(f"✅ core {version()}")
    rebuild(no_rebuild)


def channel(c):
    if c not in ("stable", "beta"):
        sys.exit("stable or beta")
    s = {**settings(), "channel": c}
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(s, indent=2) + "\n")
    say(f"channel {c}")


def main():
    a = [x for x in sys.argv[1:] if not x.startswith("--")]
    no = "--no-rebuild" in sys.argv
    if a[:1] == ["check"]:
        return print(json.dumps(check()))
    if a[:1] == ["apply"] and len(a) == 2:
        return apply(a[1], no)
    if a[:1] == ["rollback"]:
        return rollback(no)
    if a[:1] == ["channel"] and len(a) == 2:
        return channel(a[1])
    sys.exit(__doc__)


if __name__ == "__main__":
    main()
