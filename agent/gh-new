#!/usr/bin/env python3
"""gh-new — create a GitHub repo for a project on a dev box and push it there.

  gh-new new     <vmid> <name> <private|public>          scaffold ~/Projects/GitHub/<name>, then publish it
  gh-new publish <vmid> <path> <name> <private|public>   publish a project that already exists

The token is read here, from /root/devbox/keys/github_token — it is never part of the argv the
dashboard shows, and the web app and the model never see it. Creating only: this never deletes
anything, and the token deliberately has no delete_repo scope.
"""
import json, re, subprocess, sys, urllib.error, urllib.request
from pathlib import Path

TOKEN_FILE = Path("/root/devbox/keys/github_token")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,40}$")


def say(*a):
    print(*a, flush=True)


def pct(vmid, *cmd, parse=False):
    r = subprocess.run(["pct", "exec", str(vmid), "--", *cmd], capture_output=True, text=True, timeout=1800)
    out = (r.stdout or "").strip()
    if r.returncode:
        sys.exit(f"{' '.join(cmd)} failed: {(r.stderr or out).strip()[:400]}")
    return json.loads(out.splitlines()[-1]) if parse else out


def api(path, payload):
    token = TOKEN_FILE.read_text().strip() if TOKEN_FILE.exists() else ""
    if not token:
        sys.exit(f"no GitHub token in {TOKEN_FILE} — the dashboard cannot create repos without one")
    req = urllib.request.Request(
        f"https://api.github.com{path}", method="POST",
        data=json.dumps(payload).encode(),
        headers={"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
                 "Content-Type": "application/json", "User-Agent": "pve-dashboard"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")[:400]
        try:
            msg = json.loads(body)
            detail = "; ".join(x.get("message", "") for x in msg.get("errors", [])) or msg.get("message", body)
        except Exception:
            detail = body
        sys.exit(f"GitHub said {e.code}: {detail}")


def publish(vmid, path, name, private):
    say(f"→ creating {'private' if private else 'public'} repo {name} on GitHub")
    repo = api("/user/repos", {"name": name, "private": private, "auto_init": False,
                               "description": "created from the pve dashboard"})
    say(f"   {repo['html_url']}")
    say(f"→ pointing origin at {repo['ssh_url']}")
    pct(vmid, "/usr/local/bin/pv", "remote", path, repo["ssh_url"])
    say("→ pushing")
    out = pct(vmid, "/usr/local/bin/pv", "push", path, "--json", parse=True)
    for line in out.get("log", []):
        say("   " + line)
    say(f"✓ {repo['full_name']} is live at {repo['html_url']}")


def main(a):
    if len(a) < 4:
        sys.exit(__doc__)
    mode, vmid = a[0], a[1]
    if mode == "new":
        name, vis = a[2], a[3]
        if not NAME_RE.match(name):
            sys.exit("name: letters, digits, dot, dash, underscore (max 41)")
        say(f"→ scaffolding {name} on CT {vmid}")
        out = pct(vmid, "/usr/local/bin/pv", "new", name, "--json", parse=True)
        path = out["path"]
        say(f"   {path}")
    elif mode == "publish":
        path, name, vis = a[2], a[3], a[4] if len(a) > 4 else "private"
        if not NAME_RE.match(name):
            sys.exit("name: letters, digits, dot, dash, underscore (max 41)")
    else:
        sys.exit(__doc__)
    if vis not in ("private", "public"):
        sys.exit("visibility must be private or public")
    publish(vmid, path, name, vis == "private")


if __name__ == "__main__":
    main(sys.argv[1:])
