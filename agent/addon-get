#!/usr/bin/env python3
"""addon-get — install, update or remove a marketplace add-on, then rebuild the dashboard.

  addon-get install <id>    fetch it from the marketplace into addons/<id>, run its install.sh once
  addon-get update  <id>    replace addons/<id> with the marketplace's newer version
  addon-get remove  <id>    take addons/<id> out (its CT and data stay)
On a box whose addons/ is a git checkout of the marketplace repo (the owner's), the same three are
sparse-checkout add / drop and a pull.
  --no-rebuild              stage only (tests); otherwise deploy.sh runs in its own unit, dash-rebuild

Where things come from: config.json marketplace.index (the pvedash/addons index.json, or the copy in
addons/index.json when that is unreachable) names each add-on's folder in marketplace.repo, or its own repo.
Nothing is deleted: a replaced or removed add-on is moved to /var/lib/dash-addons/old/<id>-<version>-<time>.
The rebuild restarts the agent, which would kill a deploy running as its child, so it gets a unit of its own.
"""
import base64, json, os, re, shutil, subprocess, sys, tempfile, time, urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from config import CFG, DASHBOARD, DEVBOX  # noqa: E402

ADDONS = Path(os.environ.get("DASH_ADDONS_DIR") or f"{DASHBOARD}/addons")
OLD = Path(os.environ.get("DASH_ADDONS_OLD") or "/var/lib/dash-addons/old")
ID_RE = re.compile(r"^[a-z][a-z0-9-]{1,30}$")
PATH_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,60}$")
GH_RE = re.compile(r"^https://github\.com/[\w.-]+/[\w.-]+$")
MK = CFG.get("marketplace") or {}


def token():
    """a private marketplace (pvedash/addons while it is private) needs a GitHub token; it is read here, on pve,
    and only ever sent to GitHub — never to the dashboard, never in an argv"""
    f = Path(MK.get("token_file") or DEVBOX / "keys/github_token")
    try:
        return f.read_text().strip() or None
    except OSError:
        return None


def say(*a):
    print(*a, flush=True)


def index():
    # DASH_MARKET_INDEX="" (tests) skips the remote index and reads addons/index.json
    url = os.environ.get("DASH_MARKET_INDEX", MK.get("index"))
    if url:
        try:
            t = token()
            req = urllib.request.Request(url, headers={"Authorization": f"token {t}"} if t and url.startswith("https://raw.githubusercontent.com/") else {})
            with urllib.request.urlopen(req, timeout=10) as r:
                j = json.loads(r.read())
            if isinstance(j.get("addons"), list):
                return {**j, "source": "remote"}
        except Exception as e:
            say(f"marketplace index unreachable ({e.__class__.__name__}), using the local copy")
    return {**json.loads((ADDONS / "index.json").read_text()), "source": "local"}


def entry(aid):
    e = next((a for a in index()["addons"] if a.get("id") == aid), None)
    if not e:
        sys.exit(f"{aid} is not in the marketplace")
    return e


def manifest(d: Path):
    """the few addon.yaml fields we need, without a YAML dependency on a fresh host"""
    m = {}
    for line in (d / "addon.yaml").read_text().splitlines():
        k, sep, v = line.partition(":")
        if sep and not line.startswith((" ", "#")):
            m[k.strip()] = v.split("#")[0].strip().strip("'\"")
    return m


def git(*a, cwd=None):
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    t = token()
    if t:  # the header goes in through the environment, so the token is in no process' argv
        basic = base64.b64encode(f"x-access-token:{t}".encode()).decode()
        env |= {"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "http.https://github.com/.extraheader",
                "GIT_CONFIG_VALUE_0": f"Authorization: Basic {basic}"}
    r = subprocess.run(["git", *a], cwd=cwd, capture_output=True, text=True, timeout=300, env=env)
    if r.returncode:
        sys.exit(f"git {a[0]} failed: {(r.stderr or r.stdout).strip()[:400]}")


def fetch(e, tmp: Path) -> Path:
    if e.get("repo"):  # an add-on with its own repo: the whole repo is the add-on
        repo, sub = e["repo"], None
        if not GH_RE.match(repo):
            sys.exit(f"refusing source {repo!r}: only https://github.com/<owner>/<repo>")
    else:
        # the marketplace repo itself is the owner's setting; DASH_MARKET_REPO lets a test point it at a local repo
        repo = os.environ.get("DASH_MARKET_REPO") or MK.get("repo") or "https://github.com/pvedash/addons"
        sub = e.get("path") or e["id"]
        if not PATH_RE.match(sub):
            sys.exit(f"bad folder name {sub!r}")
    say(f"fetching {repo}{'/' + sub if sub else ''}")
    src = tmp / "src"
    if sub:
        git("clone", "--depth", "1", "--filter=blob:none", "--sparse", repo, str(src))
        git("sparse-checkout", "set", sub, cwd=src)
        d = src / sub
    else:
        git("clone", "--depth", "1", repo, str(src))
        d = src
    if not (d / "addon.yaml").exists():
        sys.exit("no addon.yaml there")
    shutil.rmtree(d / ".git", ignore_errors=True)
    return d


def stash(aid):
    """move addons/<id> out of the way, never delete it"""
    cur = ADDONS / aid
    OLD.mkdir(parents=True, exist_ok=True)
    dest = OLD / f"{aid}-{manifest(cur).get('version') or 'x'}-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.move(str(cur), dest)
    say(f"old copy kept in {dest}")
    return dest


def newer(a, b):
    p = lambda v: [int(x) if x.isdigit() else 0 for x in (v or "").lstrip("v").split(".")[:3]] + [0] * 3
    return p(a)[:3] > p(b)[:3]


def rebuild():
    log = "/var/log/dash-rebuild.log"
    r = subprocess.run(["systemd-run", "--unit", "dash-rebuild", "--collect", "--quiet",
                        "-p", f"StandardOutput=append:{log}", "-p", f"StandardError=append:{log}",
                        "-p", "RuntimeMaxSec=30min", "-E", "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                        f"{DASHBOARD}/deploy.sh"], capture_output=True, text=True, timeout=20)
    if r.returncode:
        sys.exit(f"could not start the rebuild (one already running?): {r.stderr.strip()[:300]}")
    say(f"rebuild started (dash-rebuild, log {log}); the dashboard is back in a few minutes")


def need_deps(e):
    """an add-on installs only after what it depends on (Deals needs the Hunters backend and Local AI)"""
    missing = [d for d in (e.get("depends_on") or []) if not (ADDONS / d / "addon.yaml").exists()]
    if missing:
        sys.exit(f"install {', '.join(missing)} first: {e.get('name', e['id'])} needs {'it' if len(missing) == 1 else 'them'}")


def checkout_mode():
    """addons/ is a git checkout of the marketplace repo (the owner's box, where add-ons are edited and pushed):
    installed = the folders in its sparse checkout, so install/remove/update are git operations, not copies"""
    return (ADDONS / ".git").exists()


def sparse(*a):
    git("sparse-checkout", *a, cwd=ADDONS)


def installed_dirs():
    return sorted(d.name for d in ADDONS.iterdir() if (d / "addon.yaml").exists())


def main_checkout(cmd, aid):
    here = ADDONS / aid
    if cmd == "remove":
        if not (here / "addon.yaml").exists():
            sys.exit(f"{aid} is not installed")
        OLD.mkdir(parents=True, exist_ok=True)
        dest = OLD / f"{aid}-{manifest(here).get('version') or 'x'}-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copytree(here, dest)  # a copy, in case it held edits that were never pushed
        sparse("set", *[d for d in installed_dirs() if d != aid])
        say(f"{aid} left the checkout (still in the repo; a copy is in {dest})")
        return
    e = entry(aid)
    if e.get("repo"):
        sys.exit(f"{aid} lives in its own repo; this box's addons/ is a checkout of the marketplace repo only")
    sub = e.get("path") or aid
    if not PATH_RE.match(sub):
        sys.exit(f"bad folder name {sub!r}")
    say("pulling the marketplace repo")
    git("pull", "--ff-only", "-q", cwd=ADDONS)
    if cmd == "install":
        if here.exists():
            sys.exit(f"{aid} is already installed")
        need_deps(e)
        sparse("add", sub)
        say(f"{aid} {manifest(here).get('version', '?')} is in {here}")
        if (here / "install.sh").exists():
            say("running its install.sh")
            r = subprocess.run(["bash", "install.sh"], cwd=here, env={**os.environ, "DASH_CONFIG": "/etc/dash/config.json"}, timeout=3600)
            if r.returncode:
                sparse("set", *[d for d in installed_dirs() if d != aid])
                sys.exit(f"install.sh failed (exit {r.returncode}); the add-on was taken out again")
    else:  # update: the pull above already brought every installed add-on to the repo's version
        say(f"{aid} is now {manifest(here).get('version', '?')} (the pull updates every installed add-on)")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if len(args) != 2 or args[0] not in ("install", "update", "remove") or not ID_RE.match(args[1]):
        sys.exit(__doc__)
    cmd, aid = args
    here = ADDONS / aid
    if checkout_mode():
        main_checkout(cmd, aid)
    elif cmd == "remove":
        if not (here / "addon.yaml").exists():
            sys.exit(f"{aid} is not installed as an add-on folder")
        stash(aid)
    else:
        e = entry(aid)
        if cmd == "install" and here.exists():
            sys.exit(f"{aid} is already installed")
        if cmd == "install":
            need_deps(e)
        if cmd == "update":
            if not (here / "addon.yaml").exists():
                sys.exit(f"{aid} is not installed")
            if not newer(e.get("version"), manifest(here).get("version")):
                sys.exit(f"{aid} is already at {manifest(here).get('version')}")
        with tempfile.TemporaryDirectory() as t:
            d = fetch(e, Path(t))
            m = manifest(d)
            if m.get("id") != aid:
                sys.exit(f"addon.yaml says id {m.get('id')!r}, expected {aid!r}")
            old = stash(aid) if cmd == "update" else None
            shutil.move(str(d), here)
        say(f"{aid} {m.get('version', '?')} is in {here}")
        if cmd == "install" and (here / "install.sh").exists():
            say("running its install.sh")
            r = subprocess.run(["bash", "install.sh"], cwd=here, env={**os.environ, "DASH_CONFIG": "/etc/dash/config.json"},
                               timeout=3600)
            if r.returncode:
                OLD.mkdir(parents=True, exist_ok=True)
                shutil.move(str(here), OLD / f"{aid}-failed-{time.strftime('%Y%m%d-%H%M%S')}")
                sys.exit(f"install.sh failed (exit {r.returncode}); the add-on was taken out again")
        if old:
            say(f"previous version: {old.name}")
    if "--no-rebuild" in sys.argv:
        say("staged only (--no-rebuild)")
    else:
        rebuild()


if __name__ == "__main__":
    main()
