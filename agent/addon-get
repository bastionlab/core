#!/usr/bin/env python3
"""addon-get — install, update or remove a marketplace add-on, then rebuild the dashboard.

  addon-get install <id>    fetch it from the marketplace into addons/<id>, run its install.sh once
  addon-get update  <id>    replace addons/<id> with the marketplace's newer version
  addon-get remove  <id>    take addons/<id> out (its CT and data stay)
  addon-get autoupdate      every installed add-on the marketplace has newer, in one go (dash-addons-update.timer);
                            off with config.json marketplace.auto_update = false
On a box whose addons/ is a git checkout of the marketplace repo (the owner's), the same three are
sparse-checkout add / drop and a pull.
  --no-rebuild              stage only (tests); otherwise deploy.sh runs in its own unit, dash-rebuild

Where things come from: config.json marketplace.index (the bastionlab/addons index.json, or the copy in
addons/index.json when that is unreachable) names each add-on's folder in marketplace.repo, or its own repo.
Before anything lands, agent/addon_scan.py checks the code (reverse shells, miners, decode-and-run, planted ssh
keys, binaries, dashboard secrets, …): a blocking finding stops the install or update; the rest goes in the log.
Nothing is deleted: a replaced or removed add-on is moved to /var/lib/dash-addons/old/<id>-<version>-<time>.
The rebuild restarts the agent, which would kill a deploy running as its child, so it gets a unit of its own.
"""
import base64, json, os, re, shutil, subprocess, sys, tempfile, time, urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from config import CFG, DASHBOARD, DEVBOX  # noqa: E402
import addon_scan  # noqa: E402
import semver  # noqa: E402

ADDONS = Path(os.environ.get("DASH_ADDONS_DIR") or f"{DASHBOARD}/addons")
OLD = Path(os.environ.get("DASH_ADDONS_OLD") or "/var/lib/dash-addons/old")
ID_RE = re.compile(r"^[a-z][a-z0-9-]{1,30}$")
PATH_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,60}$")
GH_RE = re.compile(r"^https://github\.com/[\w.-]+/[\w.-]+$")
MK = CFG.get("marketplace") or {}


def token():
    """a private marketplace (bastionlab/addons while it is private) needs a GitHub token; it is read here, on pve,
    and only ever sent to GitHub — never to the dashboard, never in an argv"""
    f = Path(MK.get("token_file") or DEVBOX / "keys/github_token")
    try:
        return f.read_text().strip() or None
    except OSError:
        return None


def say(*a):
    print(*a, flush=True)


def index():
    # DASH_MARKET_INDEX="" (tests) skips the remote index and reads addons/index.json
    url = os.environ.get("DASH_MARKET_INDEX", MK.get("index"))
    if url:
        try:
            t = token()
            req = urllib.request.Request(url, headers={"Authorization": f"token {t}"} if t and url.startswith("https://raw.githubusercontent.com/") else {})
            with urllib.request.urlopen(req, timeout=10) as r:
                j = json.loads(r.read())
            if isinstance(j.get("addons"), list):
                return {**j, "source": "remote"}
        except Exception as e:
            say(f"marketplace index unreachable ({e.__class__.__name__}), using the local copy")
    return {**json.loads((ADDONS / "index.json").read_text()), "source": "local"}


def entry(aid):
    e = next((a for a in index()["addons"] if a.get("id") == aid), None)
    if not e:
        sys.exit(f"{aid} is not in the marketplace")
    return e


def manifest(d: Path):
    """the few addon.yaml fields we need, without a YAML dependency on a fresh host"""
    m = {}
    for line in (d / "addon.yaml").read_text().splitlines():
        k, sep, v = line.partition(":")
        if sep and not line.startswith((" ", "#")):
            m[k.strip()] = v.split("#")[0].strip().strip("'\"")
    return m


def git(*a, cwd=None):
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    t = token()
    if t:  # the header goes in through the environment, so the token is in no process' argv
        basic = base64.b64encode(f"x-access-token:{t}".encode()).decode()
        env |= {"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "http.https://github.com/.extraheader",
                "GIT_CONFIG_VALUE_0": f"Authorization: Basic {basic}"}
    r = subprocess.run(["git", *a], cwd=cwd, capture_output=True, text=True, timeout=300, env=env)
    if r.returncode:
        sys.exit(f"git {a[0]} failed: {(r.stderr or r.stdout).strip()[:400]}")


def fetch(e, tmp: Path) -> Path:
    if e.get("repo"):  # an add-on with its own repo: the whole repo is the add-on
        repo, sub = e["repo"], None
        if not GH_RE.match(repo):
            sys.exit(f"refusing source {repo!r}: only https://github.com/<owner>/<repo>")
    else:
        # the marketplace repo itself is the owner's setting; DASH_MARKET_REPO lets a test point it at a local repo
        repo = os.environ.get("DASH_MARKET_REPO") or MK.get("repo") or "https://github.com/bastionlab/addons"
        sub = e.get("path") or e["id"]
        if not PATH_RE.match(sub):
            sys.exit(f"bad folder name {sub!r}")
    say(f"fetching {repo}{'/' + sub if sub else ''}")
    src = tmp / "src"
    if sub:
        git("clone", "--depth", "1", "--filter=blob:none", "--sparse", repo, str(src))
        git("sparse-checkout", "set", sub, cwd=src)
        d = src / sub
    else:
        git("clone", "--depth", "1", repo, str(src))
        d = src
    if not (d / "addon.yaml").exists():
        sys.exit("no addon.yaml there")
    shutil.rmtree(d / ".git", ignore_errors=True)
    return d


def core_version():
    try:
        return (Path(DASHBOARD) / "VERSION").read_text().strip()
    except OSError:
        return ""


def core_mismatch(d: Path):
    """why this add-on folder can't run on this core (its addon.yaml `core:` range), or None"""
    want, have = manifest(d).get("core"), core_version()
    if not want or not have:
        return None
    try:
        return None if semver.satisfies(have, want) else f"needs core {want}, this one is {have}: update the core first"
    except ValueError as e:
        return f"bad core range {want!r} ({e})"


def check(d: Path, aid, old=None):
    """the core-version gate and the safety scan; exits before anything is installed when either blocks"""
    why = core_mismatch(d)
    if why:
        sys.exit(f"{aid}: {why}; nothing was installed")
    rep = addon_scan.scan(d, old if old and old.is_dir() else None, aid, MK.get("scan_allow") or [])
    say(addon_scan.summary(rep))
    if not rep["ok"]:
        sys.exit(f"{aid}: the safety check blocked it, nothing was installed")
    return rep


def remote_tree(tmp: Path, *subs) -> Path:
    """checkout mode: the marketplace repo's fetched tip (FETCH_HEAD) of these folders, unpacked into tmp"""
    out = tmp / "tree"
    out.mkdir()
    there = set(subprocess.run(["git", "ls-tree", "--name-only", "FETCH_HEAD"], cwd=ADDONS, capture_output=True,
                               text=True, timeout=60).stdout.split())
    subs = [s for s in subs if s in there]  # a folder gone upstream has nothing to check
    if not subs:
        return out
    r = subprocess.run(f"git archive FETCH_HEAD -- {' '.join(subs)} | tar -x -C {out}", shell=True, cwd=ADDONS,
                       capture_output=True, text=True, timeout=300)
    if r.returncode:
        sys.exit(f"could not unpack the fetched add-on: {r.stderr.strip()[:300]}")
    return out


def preview(aid):
    """what the Install / Update confirm card shows: the scan of the version the marketplace would bring"""
    e = entry(aid)
    here = ADDONS / aid
    with tempfile.TemporaryDirectory() as t:
        if checkout_mode():
            if e.get("repo"):
                raise ValueError(f"{aid} lives in its own repo")
            sub = e.get("path") or aid
            if not PATH_RE.match(sub):
                raise ValueError(f"bad folder name {sub!r}")
            git("fetch", "-q", cwd=ADDONS)
            d = remote_tree(Path(t), sub) / sub
        else:
            d = fetch(e, Path(t))
        rep = addon_scan.scan(d, here if here.is_dir() else None, aid, MK.get("scan_allow") or [])
        compat = core_mismatch(d)
    return {**rep, "id": aid, "version": e.get("version"), "core_block": compat, "ok": rep["ok"] and not compat}


def stash(aid):
    """move addons/<id> out of the way, never delete it"""
    cur = ADDONS / aid
    OLD.mkdir(parents=True, exist_ok=True)
    dest = OLD / f"{aid}-{manifest(cur).get('version') or 'x'}-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.move(str(cur), dest)
    say(f"old copy kept in {dest}")
    return dest


STATE = Path(os.environ.get("DASH_ADDONS_STATE") or "/var/lib/dash-addons/state.json")
HASH_SKIP = {"__pycache__", "node_modules", ".nuxt", ".output"}


def folder_hash(d: Path):
    """what an add-on folder holds, as one hash (paths + contents), to tell local edits from what was installed"""
    import hashlib
    h = hashlib.sha256()
    for p in sorted(d.rglob("*")):
        rel = p.relative_to(d)
        if p.is_file() and not HASH_SKIP & set(rel.parts) and p.suffix != ".pyc":
            h.update(str(rel).encode() + b"\0" + p.read_bytes() + b"\0")
    return h.hexdigest()


def _state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def remember(aid):
    """addons/<id> now matches the marketplace (just installed, updated or published)"""
    s = _state()
    here = ADDONS / aid
    if (here / "addon.yaml").exists():
        s[aid] = folder_hash(here)
    else:
        s.pop(aid, None)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(s, indent=1))


def local_changes():
    """{id: "new" | "changed"} for add-ons whose folder differs from the marketplace's: what Publish would send.
    Owner's checkout: git status (untracked = new). Elsewhere: the folder hash against the one remembered."""
    out = {}
    if checkout_mode():
        r = subprocess.run(["git", "status", "--porcelain", "--untracked-files=all"], cwd=ADDONS, capture_output=True,
                           text=True, timeout=30)
        for line in r.stdout.splitlines():
            parts = line[3:].strip().strip('"').split("/")
            if len(parts) > 1 and ID_RE.match(parts[0]) and (ADDONS / parts[0] / "addon.yaml").exists():
                tracked = subprocess.run(["git", "ls-files", "--error-unmatch", f"{parts[0]}/addon.yaml"], cwd=ADDONS,
                                         capture_output=True).returncode == 0
                out[parts[0]] = "changed" if tracked else "new"
        ahead = subprocess.run(["git", "diff", "--name-only", "@{u}", "HEAD"], cwd=ADDONS, capture_output=True, text=True, timeout=30)
        for f in ahead.stdout.split():  # committed here, never pushed
            a = f.split("/")[0]
            if "/" in f and ID_RE.match(a) and (ADDONS / a / "addon.yaml").exists():
                out.setdefault(a, "changed")
        return out
    s = _state()
    for aid in installed_dirs():
        if aid not in s:
            continue  # installed before this was tracked: treat as the marketplace's
        if folder_hash(ADDONS / aid) != s[aid]:
            out[aid] = "changed"
    return out


def autoupdate():
    """the hourly pull: whatever the marketplace has newer gets installed here, then one rebuild.
    An add-on with local edits is left alone (they would be lost); so is everything while a rebuild runs."""
    if MK.get("auto_update") is False:
        say("auto-update is off (marketplace.auto_update)")
        return False
    busy = subprocess.run(["systemctl", "is-active", "--quiet", "dash-rebuild"]).returncode == 0
    if busy:
        say("a rebuild is running; next time")
        return False
    mine = local_changes()
    if checkout_mode():
        git("fetch", "-q", cwd=ADDONS)
        behind = subprocess.run(["git", "diff", "--name-only", "HEAD", "FETCH_HEAD"], cwd=ADDONS, capture_output=True,
                                text=True, timeout=60).stdout.split()
        touched = sorted({f.split("/")[0] for f in behind if "/" in f} & set(installed_dirs()))
        if not touched and not any(f == "index.json" for f in behind):
            say("everything is up to date")
            return False
        if set(touched) & set(mine):
            say(f"not pulling: local edits in {', '.join(sorted(set(touched) & set(mine)))} (publish them first)")
            return False
        with tempfile.TemporaryDirectory() as t:
            tree = remote_tree(Path(t), *touched)
            for s in touched:
                if (tree / s).is_dir():
                    check(tree / s, s, ADDONS / s)
        git("merge", "--ff-only", "-q", "FETCH_HEAD", cwd=ADDONS)
        say(f"pulled: {', '.join(touched) or 'index only'}")
        return bool(touched)
    todo = [e for e in index()["addons"] if (ADDONS / e["id"] / "addon.yaml").exists()
            and newer(e.get("version"), manifest(ADDONS / e["id"]).get("version"))]
    done = []
    for e in todo:
        if e["id"] in mine:
            say(f"{e['id']}: local edits, not updating")
            continue
        r = subprocess.run([sys.executable, "-I", __file__, "update", e["id"], "--no-rebuild"], timeout=1800)
        if r.returncode == 0:
            done.append(e["id"])
    say(f"updated: {', '.join(done)}" if done else "everything is up to date")
    return bool(done)


def newer(a, b):
    p = lambda v: [int(x) if x.isdigit() else 0 for x in (v or "").lstrip("v").split(".")[:3]] + [0] * 3
    return p(a)[:3] > p(b)[:3]


def rebuild():
    log = "/var/log/dash-rebuild.log"
    r = subprocess.run(["systemd-run", "--unit", "dash-rebuild", "--collect", "--quiet",
                        "-p", f"StandardOutput=append:{log}", "-p", f"StandardError=append:{log}",
                        "-p", "RuntimeMaxSec=30min", "-E", "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                        f"{DASHBOARD}/deploy.sh"], capture_output=True, text=True, timeout=20)
    if r.returncode:
        sys.exit(f"could not start the rebuild (one already running?): {r.stderr.strip()[:300]}")
    say(f"rebuild started (dash-rebuild, log {log}); the dashboard is back in a few minutes")


def need_deps(e):
    """an add-on installs only after what it depends on (Deals needs the Hunters backend and Local AI)"""
    missing = [d for d in (e.get("depends_on") or []) if not (ADDONS / d / "addon.yaml").exists()]
    if missing:
        sys.exit(f"install {', '.join(missing)} first: {e.get('name', e['id'])} needs {'it' if len(missing) == 1 else 'them'}")


def checkout_mode():
    """addons/ is a git checkout of the marketplace repo (the owner's box, where add-ons are edited and pushed):
    installed = the folders in its sparse checkout, so install/remove/update are git operations, not copies"""
    return (ADDONS / ".git").exists()


KEEP = (".github",)  # the publish checks, not an add-on: stays in the checkout


def sparse(*a):
    git("sparse-checkout", *a, cwd=ADDONS)


def installed_dirs():
    return sorted(d.name for d in ADDONS.iterdir() if (d / "addon.yaml").exists())


def main_checkout(cmd, aid):
    here = ADDONS / aid
    if cmd == "remove":
        if not (here / "addon.yaml").exists():
            sys.exit(f"{aid} is not installed")
        OLD.mkdir(parents=True, exist_ok=True)
        dest = OLD / f"{aid}-{manifest(here).get('version') or 'x'}-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copytree(here, dest)  # a copy, in case it held edits that were never pushed
        sparse("set", *KEEP, *[d for d in installed_dirs() if d != aid])
        say(f"{aid} left the checkout (still in the repo; a copy is in {dest})")
        return
    e = entry(aid)
    if e.get("repo"):
        sys.exit(f"{aid} lives in its own repo; this box's addons/ is a checkout of the marketplace repo only")
    sub = e.get("path") or aid
    if not PATH_RE.match(sub):
        sys.exit(f"bad folder name {sub!r}")
    if cmd == "install":
        if here.exists():
            sys.exit(f"{aid} is already installed")
        need_deps(e)
    # fetch, check what would land (the new add-on, or on update every installed one: the pull moves them all),
    # and only then fast-forward
    say("fetching the marketplace repo")
    git("fetch", "-q", cwd=ADDONS)
    subs = [sub] if cmd == "install" else installed_dirs()
    with tempfile.TemporaryDirectory() as t:
        tree = remote_tree(Path(t), *subs)
        for s in subs:
            if (tree / s).is_dir():
                check(tree / s, s, ADDONS / s if cmd == "update" else None)
    git("merge", "--ff-only", "-q", "FETCH_HEAD", cwd=ADDONS)
    if cmd == "install":
        sparse("add", sub)
        say(f"{aid} {manifest(here).get('version', '?')} is in {here}")
        if (here / "install.sh").exists():
            say("running its install.sh")
            r = subprocess.run(["bash", "install.sh"], cwd=here, env={**os.environ, "DASH_CONFIG": "/etc/dash/config.json"}, timeout=3600)
            if r.returncode:
                sparse("set", *KEEP, *[d for d in installed_dirs() if d != aid])
                sys.exit(f"install.sh failed (exit {r.returncode}); the add-on was taken out again")
    else:  # update: the pull above already brought every installed add-on to the repo's version
        say(f"{aid} is now {manifest(here).get('version', '?')} (the pull updates every installed add-on)")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if args == ["autoupdate"]:
        if autoupdate() and "--no-rebuild" not in sys.argv:
            rebuild()
        return
    if len(args) != 2 or args[0] not in ("install", "update", "remove") or not ID_RE.match(args[1]):
        sys.exit(__doc__)
    cmd, aid = args
    here = ADDONS / aid
    if checkout_mode():
        main_checkout(cmd, aid)
    elif cmd == "remove":
        if not (here / "addon.yaml").exists():
            sys.exit(f"{aid} is not installed as an add-on folder")
        stash(aid)
    else:
        e = entry(aid)
        if cmd == "install" and here.exists():
            sys.exit(f"{aid} is already installed")
        if cmd == "install":
            need_deps(e)
        if cmd == "update":
            if not (here / "addon.yaml").exists():
                sys.exit(f"{aid} is not installed")
            if not newer(e.get("version"), manifest(here).get("version")):
                sys.exit(f"{aid} is already at {manifest(here).get('version')}")
        with tempfile.TemporaryDirectory() as t:
            d = fetch(e, Path(t))
            m = manifest(d)
            if m.get("id") != aid:
                sys.exit(f"addon.yaml says id {m.get('id')!r}, expected {aid!r}")
            check(d, aid, here if cmd == "update" else None)
            old = stash(aid) if cmd == "update" else None
            shutil.move(str(d), here)
        say(f"{aid} {m.get('version', '?')} is in {here}")
        if cmd == "install" and (here / "install.sh").exists():
            say("running its install.sh")
            r = subprocess.run(["bash", "install.sh"], cwd=here, env={**os.environ, "DASH_CONFIG": "/etc/dash/config.json"},
                               timeout=3600)
            if r.returncode:
                OLD.mkdir(parents=True, exist_ok=True)
                shutil.move(str(here), OLD / f"{aid}-failed-{time.strftime('%Y%m%d-%H%M%S')}")
                sys.exit(f"install.sh failed (exit {r.returncode}); the add-on was taken out again")
        if old:
            say(f"previous version: {old.name}")
    remember(aid)
    if checkout_mode() and cmd == "update":
        for d in installed_dirs():
            remember(d)
    if "--no-rebuild" in sys.argv:
        say("staged only (--no-rebuild)")
    else:
        rebuild()


if __name__ == "__main__":
    main()
