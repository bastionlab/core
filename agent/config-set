#!/usr/bin/env python3
"""config-set <path> <json value> — change one setting in /etc/dash/config.json (Settings → General), then rebuild.

The value is checked again here (config.config_change); the old file is kept as config.json.<time>.bak.
--no-rebuild: write only (tests). The rebuild runs in its own unit, like addon-get's, because it restarts the agent.
"""
import json, os, subprocess, sys, time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from config import DASHBOARD, config_change  # noqa: E402

FILE = Path(os.environ.get("DASH_CONFIG_FILE") or "/etc/dash/config.json")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if len(args) != 2:
        sys.exit(__doc__)
    path, raw = args
    cur = json.loads(FILE.read_text())
    old, new, cfg = config_change(path, json.loads(raw), cur)
    bak = FILE.with_name(f"{FILE.name}.{time.strftime('%Y%m%d-%H%M%S')}.bak")
    bak.write_text(FILE.read_text())
    tmp = FILE.with_name(f".{FILE.name}.tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    os.chmod(tmp, 0o644)
    tmp.replace(FILE)
    print(f"{path}: {json.dumps(old)} → {json.dumps(new)} (old file kept as {bak.name})", flush=True)
    if "--no-rebuild" in sys.argv:
        return
    log = "/var/log/dash-rebuild.log"
    r = subprocess.run(["systemd-run", "--unit", "dash-rebuild", "--collect", "--quiet",
                        "-p", f"StandardOutput=append:{log}", "-p", f"StandardError=append:{log}", "-p", "RuntimeMaxSec=30min",
                        "-E", "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", f"{DASHBOARD}/deploy.sh"],
                       capture_output=True, text=True, timeout=20)
    if r.returncode:
        sys.exit(f"saved, but the rebuild did not start (one already running?): {r.stderr.strip()[:300]}")
    print(f"rebuild started (dash-rebuild, log {log}); the dashboard is back in a few minutes", flush=True)


if __name__ == "__main__":
    main()
