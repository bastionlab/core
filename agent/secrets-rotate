#!/usr/bin/env python3
"""secrets-rotate — new internal tokens (Settings → Secrets → Rotate), then redeploy both ends of each.

Rotated: agent/token (app ↔ agent), agent/lan_key (Caddy ↔ app), <backends>/deals/token and <backends>/money/token
(app ↔ their CTs). Each old file is kept as <name>.old. The backends are redeployed first, then the dashboard;
if any step fails every token goes back to its old value and the same deploys run again.
Runs in its own unit (dash-rebuild) because deploy.sh restarts the agent that started it. Values never hit argv.
--no-deploy: write only (tests).
"""
import os, secrets, shutil, subprocess, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from config import CFG, DASHBOARD  # noqa: E402

AGENT = Path(DASHBOARD) / "agent"
BACK = Path((CFG.get("paths") or {}).get("backends") or "/root")
PATH_ENV = {**os.environ, "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"}


def files():
    """(token file, deploy script or None) — a backend that isn't installed here is skipped"""
    out = [(AGENT / "token", None), (AGENT / "lan_key", None)]
    for b in ("deals", "money"):
        if (BACK / b / "token").exists() and (BACK / b / "deploy.sh").exists():
            out.append((BACK / b / "token", BACK / b / "deploy.sh"))
    return out


def write(f: Path, v: str):
    tmp = f.with_name(f".{f.name}.tmp")
    tmp.write_text(v + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(f)


def deploy(fs):
    for f, d in fs:
        if d:
            print(f"→ {d.parent.name}", flush=True)
            subprocess.run([str(d)], check=True, env=PATH_ENV, timeout=900)
    print("→ dashboard", flush=True)
    subprocess.run([f"{DASHBOARD}/deploy.sh"], check=True, env=PATH_ENV, timeout=1800)


def main():
    fs = files()
    for f, _ in fs:
        shutil.copy2(f, f.with_name(f.name + ".old"))
        write(f, secrets.token_hex(32))
        print(f"new {f}", flush=True)
    if "--no-deploy" in sys.argv:
        return
    try:
        deploy(fs)
    except Exception as e:
        print(f"✗ {e} — putting the old tokens back", flush=True)
        for f, _ in fs:
            shutil.copy2(f.with_name(f.name + ".old"), f)
        deploy(fs)
        sys.exit("rotation failed; old tokens restored")
    print("✅ rotated; every browser has to enter the PIN again", flush=True)


if __name__ == "__main__":
    main()
